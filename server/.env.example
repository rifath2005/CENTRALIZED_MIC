# LiveKit Cloud or Self-Hosted Credentials (Template)
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_api_key_here
LIVEKIT_API_SECRET=your_api_secret_here

# Server Configuration
PORT=4000
ALLOWED_ORIGIN=*
TOKEN_TTL=3600

# Google Identity Services OAuth 2.0 Web Client ID
GOOGLE_CLIENT_ID=your_google_client_id_here

# SMTP Email Settings (for Real Password Reset Emails)
# Examples:
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=your@gmail.com, SMTP_PASS=your_app_password
# SendGrid: SMTP_HOST=smtp.sendgrid.net, SMTP_PORT=587, SMTP_USER=apikey, SMTP_PASS=your_sendgrid_key
# Brevo: SMTP_HOST=smtp-relay.brevo.com, SMTP_PORT=587, SMTP_USER=your_login, SMTP_PASS=your_master_key
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="AirMic Security" <no-reply@centralizedmic.com>
APP_URL=http://localhost:5173
ADMIN_EMAILS=babsword3@gmail.com
